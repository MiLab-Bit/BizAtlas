# BizAtlas · 环境变量模板（脱敏示例，勿提交真实密钥）
# 复制为 .env 后按需填写。数据源默认全关（除本地），在 content/providers/registry.yaml 里逐个 enabled: true

# --- LLM（可插拔；可空 = 跳过润色/NL，核心评分仍可用）---
# OpenAI 兼容：填你的 API Base + Model
LLM_PROVIDER=openai_compatible
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=Qwen-flash

# --- 运行模式：snapshot | hybrid | live ---
# snapshot = 仅上传 + fixtures（答辩默认，不依赖外网 API）
# hybrid   = 按 registry 启用源拉取，失败降级
# live     = 尽量 L1（仍遵守降级）
BIZATLAS_MODE=snapshot

# --- 数据源密钥（占位：有了再填，并改 registry.yaml 对应 enabled）---
# P0 财务
TUSHARE_TOKEN=
# AKShare 无需 token；registry 里 akshare.enabled 即可

# P1 工商司法（主用一个即可）
TIANYANCHA_TOKEN=
QICHACHA_TOKEN=
# 无商业 Key 时的 JSON 导出目录（company_json_import）
COMPANY_JSON_DIR=./content/fixtures/company_json

# P1 巨潮：一般无需 key；若后续加代理/限流配置可放这里
CNINFO_BASE_URL=
CNINFO_USER_AGENT=

# P2 舆情（占位）
NEWS_PROVIDER=
NEWS_API_KEY=

# --- 存储 ---
BIZATLAS_DB_PATH=./data/bizatlas.sqlite
BIZATLAS_UPLOAD_DIR=./uploads
BIZATLAS_EXPORT_DIR=./exports
BIZATLAS_PROVIDERS_REGISTRY=./content/providers/registry.yaml

# --- API / Web ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
VITE_API_BASE=http://127.0.0.1:8000

# --- 阶段 3：企业化部署 ---
# 鉴权（RBAC）。开发/演示保持默认（auth_disabled=true，等价 ADMIN 全放行，前端无感）。
# 生产：auth_disabled=false + 设置 auth_secret，端点即启用 HMAC 令牌鉴权，
#       调用方需带 Authorization: Bearer <token>（token 由 bizatlas.auth.rbac.issue_token 签发）。
BIZATLAS_ENV=prod
BIZATLAS_AUTH_DISABLED=true
BIZATLAS_AUTH_SECRET=

# 部署运行模式（容器/编排用）
# BIZATLAS_MODE 已在上方定义（snapshot | hybrid | live）
