.page{padding:24rpx;}
.loading{text-align:center;padding:80rpx;color:#94A3B8;}
.card{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx;border:1rpx solid #E2E8F0;}
.title{font-size:36rpx;font-weight:700;color:#0F172A;}
.grade{display:inline-block;margin-top:12rpx;padding:6rpx 18rpx;border-radius:999rpx;font-size:26rpx;font-weight:600;}
.card-title{font-size:30rpx;font-weight:600;color:#0F172A;margin-bottom:16rpx;}
.row{display:flex;justify-content:space-between;padding:10rpx 0;border-bottom:1rpx solid #F1F5F9;}
.k{color:#64748B;font-size:26rpx;}
.v{color:#0F172A;font-size:26rpx;font-weight:500;}
.para{font-size:26rpx;color:#334155;line-height:1.6;}
.btn{background:#2563EB;color:#fff;border-radius:12rpx;}
