/* pages/risk/analyze.wxss */
.page{padding:24rpx;}
.card{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx;border:1rpx solid #E2E8F0;}
.card-title{font-size:34rpx;font-weight:700;color:#0F172A;margin-bottom:24rpx;}
.field{margin-bottom:20rpx;}
.field-label{display:block;font-size:26rpx;color:#475569;margin-bottom:10rpx;}
.input,.textarea{background:#F8FAFC;border:1rpx solid #E2E8F0;border-radius:12rpx;padding:18rpx;font-size:28rpx;width:100%;box-sizing:border-box;}
.textarea{min-height:120rpx;}
.btn-submit{background:#2563EB;color:#fff;border-radius:12rpx;margin-top:12rpx;}
.grade-banner{text-align:center;font-size:34rpx;font-weight:700;padding:24rpx;border-radius:16rpx;margin-bottom:20rpx;}
.dims{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-bottom:20rpx;}
.dim{background:#F8FAFC;border-radius:10rpx;padding:16rpx;display:flex;justify-content:space-between;}
.dim-name{font-size:24rpx;color:#64748B;}
.dim-score{font-size:28rpx;font-weight:700;color:#0F172A;}
.section{margin-top:20rpx;}
.section-title{font-size:28rpx;font-weight:600;color:#0F172A;margin-bottom:8rpx;}
.para{font-size:26rpx;color:#334155;line-height:1.6;}
.list-item{font-size:26rpx;color:#475569;padding:4rpx 0;line-height:1.6;}
