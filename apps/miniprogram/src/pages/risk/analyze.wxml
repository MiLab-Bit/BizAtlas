<!--pages/risk/analyze.wxml—风险分析-->
<view class="page">
  <view class="card">
    <view class="card-title">风险分析</view>
    <view class="field">
      <text class="field-label">企业ID（可用演示案例）</text>
      <input class="input" placeholder="如：healthy / risky / defaulted" value="{{form.companyId}}" bindinput="onCompany"/>
    </view>
    <view class="field">
      <text class="field-label">分析诉求（可选）</text>
      <textarea class="textarea" placeholder="如：关注担保链与关联交易风险" value="{{form.query}}" bindinput="onQuery"/>
    </view>
    <button class="btn-submit" bindtap="onSubmit" loading="{{loading}}" disabled="{{loading}}">开始研判</button>
  </view>

  <view wx:if="{{result}}" class="card">
    <view class="grade-banner" style="color:{{result.gradeStyle.color}};background:{{result.gradeStyle.bg}}">
      {{result.gradeStyle.label}} · 风险分 {{result.score || '—'}}
    </view>
    <view wx:if="{{result.dimensions}}" class="dims">
      <view wx:for="{{result.dimensions}}" wx:key="key" class="dim">
        <text class="dim-name">{{item.name||item.key}}</text>
        <text class="dim-score">{{item.score}}</text>
      </view>
    </view>
    <view wx:if="{{result.summary}}" class="section">
      <view class="section-title">研判摘要</view>
      <view class="para">{{result.summary}}</view>
    </view>
    <view wx:if="{{result.events && result.events.length}}" class="section">
      <view class="section-title">命中事件</view>
      <view wx:for="{{result.events}}" wx:key="*this" class="list-item">• {{item}}</view>
    </view>
  </view>
</view>
