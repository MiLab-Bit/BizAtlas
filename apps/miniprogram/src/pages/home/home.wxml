<!--pages/home/home.wxml-->
<view class="home">
  <view class="hero">
    <view class="hero-title">商舆 BizAtlas</view>
    <view class="hero-sub">企业经营与风险研判 Agent</view>
    <view class="hero-tag">GOAI 2026 复赛 · AI+金融</view>
  </view>

  <view class="feature-grid">
    <view
      wx:for="{{features}}"
      wx:key="key"
      class="feature-card"
      bindtap="onNavigate"
      data-path="{{item.path}}"
    >
      <view class="feature-icon">{{item.icon}}</view>
      <view class="feature-body">
        <view class="feature-title">{{item.title}}</view>
        <view class="feature-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="footer" bindtap="onAbout">
    <text>关于商舆 · 数据合规声明</text>
  </view>
</view>
