/* pages/home/home.wxss — 移动端友好卡片布局 */
.home { padding: 24rpx; }

.hero {
  background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 32rpx;
}
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; opacity: .9; margin-top: 8rpx; }
.hero-tag {
  display: inline-block;
  margin-top: 20rpx;
  padding: 6rpx 16rpx;
  background: rgba(255,255,255,.18);
  border-radius: 999rpx;
  font-size: 22rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15,23,42,.06);
  border: 1rpx solid #E2E8F0;
}
.feature-card:active { background: #F8FAFC; }

.feature-icon {
  width: 80rpx; height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  background: #EFF6FF;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.feature-body { flex: 1; }
.feature-title { font-size: 32rpx; font-weight: 600; color: #0F172A; }
.feature-desc { font-size: 24rpx; color: #64748B; margin-top: 6rpx; line-height: 1.4; }

.footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
  color: #94A3B8;
  font-size: 24rpx;
}
